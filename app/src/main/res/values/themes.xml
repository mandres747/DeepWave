<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Edge-to-edge comes from the theme plus
         WindowCompat.setDecorFitsSystemWindows(window, false), not from
         androidx.activity's enableEdgeToEdge(): that one calls
         Window.setStatusBarColor/setNavigationBarColor and sets
         LAYOUT_IN_DISPLAY_CUTOUT_MODE_SHORT_EDGES, which Play flags as
         deprecated on every release (still true in activity 1.13.0). -->
    <style name="Base.Theme.BinauralBeats" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">#FF1D0E1D</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <!-- Below Android 10 the system draws no scrim behind the buttons, so
             the bar keeps the dark scrim enableEdgeToEdge() used there. -->
        <item name="android:navigationBarColor">#801B1B1B</item>
    </style>

    <style name="Theme.BinauralBeats" parent="Base.Theme.BinauralBeats" />
</resources>
